<Window x:Class="SimpleToDoMemo.Views.EditLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Background="{StaticResource Surface}"
        Width="380" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border Padding="20,2,20,18">
    <StackPanel>
        <TextBlock x:Name="NameLabel" Style="{StaticResource DlgLabel}"/>
        <TextBox x:Name="NameBox" Style="{StaticResource DlgInput}"/>
        <TextBlock x:Name="UrlLabel" Style="{StaticResource DlgLabel}"/>
        <TextBox x:Name="UrlBox" Style="{StaticResource DlgInput}" Tag="https://"/>
        <TextBlock x:Name="Hint" FontSize="11.5" Foreground="{StaticResource Red}" Margin="2,8,0,0" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelBtn" Style="{StaticResource GhostBtn}" IsCancel="True"/>
            <Button x:Name="SaveBtn" Style="{StaticResource PrimaryBtn}" IsDefault="True" Margin="6,0,0,0"/>
        </StackPanel>
    </StackPanel>
    </Border>
</Window>

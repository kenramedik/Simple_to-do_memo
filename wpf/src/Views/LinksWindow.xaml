<Window x:Class="SimpleToDoMemo.Views.LinksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SimpleToDoMemo.Views"
        Style="{StaticResource AppWindow}"
        Width="420" Height="640" MinWidth="340" MinHeight="420"
        Icon="pack://application:,,,/Assets/icon.ico">

    <Window.Resources>
        <Style x:Key="Ring" TargetType="Border">
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Margin" Value="-3"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentRing}"/>
                </Trigger>
                <Trigger Property="ui:Ui.IsBad" Value="True">
                    <Setter Property="BorderBrush" Value="#29B8564D"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Field" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
                <Trigger Property="ui:Ui.IsBad" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Red}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ─── 헤더 ─── -->
        <StackPanel Margin="20,16,20,12">
            <DockPanel>
                <Button x:Name="NewGroupBtn" DockPanel.Dock="Right" Style="{StaticResource Chip}" Padding="9,0,11,0">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl x:Name="PlusIcon" Focusable="False" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock x:Name="NewGroupLabel" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <Run x:Name="TitleRun" FontSize="22" FontWeight="Bold"/><Run x:Name="TotalRun" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text3}"/>
                </TextBlock>
            </DockPanel>

            <Border Style="{StaticResource Ring}" CornerRadius="14" Margin="-3,9,-3,-3">
                <Border Style="{StaticResource Field}" Height="38" CornerRadius="11" Padding="12,0,6,0">
                    <DockPanel>
                        <ContentControl x:Name="QIcon" Focusable="False" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,9,0"
                                        Foreground="{StaticResource Text3}"/>
                        <Button x:Name="QClear" DockPanel.Dock="Right" Style="{StaticResource FlatBtn}" Foreground="{StaticResource Text3}" Visibility="Collapsed"/>
                        <TextBlock x:Name="QCount" DockPanel.Dock="Right" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Text3}"
                                   VerticalAlignment="Center" Margin="9,0"/>
                        <TextBox x:Name="Q" Style="{StaticResource BareInput}" FontSize="13.5"/>
                    </DockPanel>
                </Border>
            </Border>
        </StackPanel>

        <!-- ─── 목록 ─── -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="ListScroll" Style="{StaticResource ListScroll}">
                <StackPanel x:Name="ListPanel" Margin="20,0,20,12"/>
            </ScrollViewer>
            <ContentControl x:Name="EmptyHost" Focusable="False" IsHitTestVisible="False"/>
        </Grid>

        <!-- ─── 추가 ─── -->
        <Border Grid.Row="2" Padding="20,10,20,16" Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <StackPanel>
                <StackPanel x:Name="TargetRow" Orientation="Horizontal" Margin="2,0,0,7">
                    <TextBlock x:Name="TargetLabel" FontSize="11.5" Foreground="{StaticResource Text3}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Button x:Name="TargetBtn" Style="{StaticResource BaseButton}" Padding="6,2" Foreground="{StaticResource Accent}"
                            FontSize="11.5" FontWeight="Bold" ui:Ui.Radius="6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TargetName" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <ContentControl x:Name="TargetChev" Focusable="False" Margin="3,1,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Border x:Name="AddRing" Style="{StaticResource Ring}" CornerRadius="15">
                    <Border x:Name="AddField" Style="{StaticResource Field}" Height="44" CornerRadius="12" Padding="0,0,6,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NameIn" Style="{StaticResource BareInput}" FontSize="13.5" Padding="14,0,10,0"/>
                            <Border Grid.Column="1" Width="1" Height="20" Background="{StaticResource Border}"/>
                            <TextBox x:Name="UrlIn" Grid.Column="2" Style="{StaticResource BareInput}" FontSize="13.5" Padding="12,0,10,0"/>
                            <Button x:Name="AddBtn" Grid.Column="3" Style="{StaticResource SubmitBtn}" IsEnabled="False"/>
                        </Grid>
                    </Border>
                </Border>
                <TextBlock x:Name="AddHint" FontSize="11.5" Foreground="{StaticResource Red}" Margin="2,6,0,-4" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:SimpleToDoMemo.Views">

    <!-- ─────────── 색 (Electron 판과 같은 값) ─────────── -->
    <Color x:Key="C.Bg">#F5F5F3</Color>
    <Color x:Key="C.Surface">#FFFFFF</Color>
    <Color x:Key="C.Accent">#0E7490</Color>

    <SolidColorBrush x:Key="Bg" Color="#F5F5F3"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="#FAFAF9"/>
    <SolidColorBrush x:Key="Border" Color="#E7E7E2"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#D6D6CF"/>
    <SolidColorBrush x:Key="Text" Color="#1C1C1A"/>
    <SolidColorBrush x:Key="Text2" Color="#71716B"/>
    <SolidColorBrush x:Key="Text3" Color="#A3A39C"/>
    <SolidColorBrush x:Key="Accent" Color="#0E7490"/>
    <SolidColorBrush x:Key="AccentHover" Color="#155E75"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#E6F4F8"/>
    <SolidColorBrush x:Key="AccentLine" Color="#CBE2EA"/>
    <SolidColorBrush x:Key="AccentWash" Color="#1F0E7490"/>
    <SolidColorBrush x:Key="AccentRing" Color="#2E0E7490"/>
    <SolidColorBrush x:Key="TodayBg" Color="#E4EEF2"/>
    <SolidColorBrush x:Key="Red" Color="#B8564D"/>
    <SolidColorBrush x:Key="RedWash" Color="#1FB8564D"/>
    <SolidColorBrush x:Key="Blue" Color="#3D6BA8"/>
    <SolidColorBrush x:Key="Holiday" Color="#14B8564D"/>
    <SolidColorBrush x:Key="HolidayHover" Color="#26B8564D"/>
    <SolidColorBrush x:Key="TipBg" Color="#2B2B29"/>
    <SolidColorBrush x:Key="TipFg" Color="#F7F7F5"/>
    <SolidColorBrush x:Key="PopBg" Color="#FDFDFC"/>
    <SolidColorBrush x:Key="PopBorder" Color="#D5D5CF"/>
    <SolidColorBrush x:Key="Hover" Color="#12000000"/>
    <SolidColorBrush x:Key="Press" Color="#1A000000"/>
    <SolidColorBrush x:Key="Mark" Color="#3D0E7490"/>

    <DropShadowEffect x:Key="ShadowSm" BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.06" Color="#141412" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="ShadowMd" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.12" Color="#141412" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="ShadowPop" BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.20" Color="#141412"/>

    <FontFamily x:Key="Ui">pack://application:,,,/Fonts/#Pretendard</FontFamily>

    <!-- ─────────── 창 ─────────── -->
    <Style x:Key="AppWindow" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Bg}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- ─────────── 툴팁 ─────────── -->
    <Style TargetType="ToolTip">
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TipFg}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource TipBg}" CornerRadius="7" Padding="9,5" MaxWidth="320" Margin="0,0,0,2">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─────────── 버튼 ─────────── -->
    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Text2}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="ui:Ui.Radius" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                            CornerRadius="{TemplateBinding ui:Ui.Radius}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 테두리 있는 네모 아이콘 버튼 (헤더) -->
    <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Effect" Value="{StaticResource ShadowSm}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
                <Setter Property="Effect" Value="{x:Null}"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource IconBtn}">
        <Setter Property="Width" Value="NaN"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- 테두리 없는 작은 버튼 (달력 넘기기, 고정 항목 동작 등) -->
    <Style x:Key="FlatBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="ui:Ui.Radius" Value="7"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Hover}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.28"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SubmitBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="ui:Ui.Radius" Value="9"/>
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="Foreground" Value="White"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentHover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.3"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="Foreground" Value="White"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentHover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource Text3}"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Text2}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceHover}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ─────────── 입력칸 ─────────── -->
    <!-- 테두리 없는 입력칸 - 바깥 Border 가 모양을 맡는다. 안내 문구는 Tag 에 넣는다. -->
    <Style x:Key="BareInput" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid Background="{TemplateBinding Background}">
                        <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="{StaticResource Text3}"
                                   Margin="{TemplateBinding Padding}" Padding="2,0,0,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Visibility="Collapsed"/>
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                      Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 대화상자의 테두리 있는 입력칸. ui:Ui.IsBad 가 켜지면 빨갛게 -->
    <Style x:Key="DlgInput" TargetType="TextBox" BasedOn="{StaticResource BareInput}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="ring" CornerRadius="11" BorderThickness="3" BorderBrush="Transparent" Margin="-3">
                        <Border x:Name="bd" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource BorderStrong}"
                                Background="{StaticResource Surface}">
                            <Grid>
                                <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="{StaticResource Text3}"
                                           Margin="{TemplateBinding Padding}" Padding="2,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False" Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                              Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource AccentRing}"/>
                        </Trigger>
                        <Trigger Property="ui:Ui.IsBad" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Red}"/>
                            <Setter TargetName="ring" Property="BorderBrush" Value="#29B8564D"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─────────── 스크롤바 - 가늘게, 화살표 없이 ─────────── -->
    <Style x:Key="ThinThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" Background="{StaticResource BorderStrong}" CornerRadius="3" Margin="3,2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Background" Value="{StaticResource Text3}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="t" Property="Background" Value="{StaticResource Text3}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ThinThumb}"/>
                        </Track.Thumb>
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                        </Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 스크롤바가 내용 위에 겹치지 않고 오른쪽 여백 안에 들어가게 -->
    <Style x:Key="ListScroll" TargetType="ScrollViewer">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Margin="0,0,5,0"
                                   Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─────────── 메뉴 (메뉴바·우클릭 메뉴) ─────────── -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="8,4" Background="{StaticResource Border}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Geometry x:Key="TickGeo">M4 12.5l5.5 5.5L20 6.5</Geometry>

    <Style TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="bd" Height="28" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Viewbox x:Name="tick" Width="12" Height="12" HorizontalAlignment="Left" Margin="-19,0,0,0" Visibility="Collapsed">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource TickGeo}" Stroke="{TemplateBinding Foreground}" StrokeThickness="3"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                            <DockPanel>
                                <TextBlock x:Name="gesture" DockPanel.Dock="Right" Text="{TemplateBinding InputGestureText}"
                                           Foreground="{StaticResource Text3}" FontSize="12" Margin="24,0,0,0" VerticalAlignment="Center"/>
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </DockPanel>
                            <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom" VerticalOffset="-3" HorizontalOffset="-17" AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="None">
                                <Border Margin="8,6,8,10" Background="{StaticResource PopBg}" BorderBrush="{StaticResource PopBorder}"
                                        BorderThickness="1" CornerRadius="7" Padding="4" MinWidth="210" Effect="{StaticResource ShadowPop}">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Text3}"/>
                        </Trigger>
                        <!-- 메뉴바의 맨 윗단 항목 -->
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="bd" Property="Height" Value="22"/>
                            <Setter TargetName="gesture" Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Padding" Value="9,0"/>
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Press}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="danger">
                            <Setter Property="Foreground" Value="{StaticResource Red}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="danger"/>
                                <Condition Property="IsHighlighted" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource RedWash}"/>
                        </MultiTrigger>
                        <Trigger Property="Tag" Value="on">
                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="heading">
                            <Setter TargetName="bd" Property="Height" Value="22"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{StaticResource Text3}"/>
                            <Setter Property="IsHitTestVisible" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 메뉴바 드롭다운 항목 - 체크 표시 자리를 왼쪽에 남긴다 -->
    <Style x:Key="BarItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="Padding" Value="28,0,12,0"/>
    </Style>

    <Style TargetType="Menu">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Menu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                            Height="28" Padding="2,0">
                        <StackPanel IsItemsHost="True" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="HorizontalOffset" Value="-8"/>
        <Setter Property="VerticalOffset" Value="-6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="8,6,8,10" Background="{StaticResource PopBg}" BorderBrush="{StaticResource PopBorder}"
                            BorderThickness="1" CornerRadius="7" Padding="4" MinWidth="168" MaxWidth="280"
                            Effect="{StaticResource ShadowPop}">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ─────────── 대화상자 ─────────── -->
    <Style x:Key="DlgLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text2}"/>
        <Setter Property="Margin" Value="0,14,0,5"/>
    </Style>

</ResourceDictionary>

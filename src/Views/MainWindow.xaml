<Window x:Class="SimpleToDoMemo.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SimpleToDoMemo.Views"
        Style="{StaticResource AppWindow}"
        Width="460" Height="740" MinWidth="360" MinHeight="440"
        Icon="pack://application:,,,/Assets/icon.ico">

    <Window.Resources>
        <!-- 입력칸을 감싼 테두리 - 포커스가 들어오면 강조색 테두리와 옅은 고리 -->
        <Style x:Key="Ring" TargetType="Border">
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Margin" Value="-3"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentRing}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Field" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MonthBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="-7,0,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="ui:Ui.Radius" Value="6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Hover}"/>
                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu x:Name="MenuBar" Grid.Row="0">
            <MenuItem x:Name="MFile">
                <MenuItem x:Name="MLinks" Style="{StaticResource BarItem}" InputGestureText="Ctrl+L"/>
                <Separator/>
                <MenuItem x:Name="MImport" Style="{StaticResource BarItem}"/>
                <Separator/>
                <MenuItem x:Name="MExit" Style="{StaticResource BarItem}" InputGestureText="Ctrl+Q"/>
            </MenuItem>
            <MenuItem x:Name="MSettings">
                <MenuItem x:Name="MTop" Style="{StaticResource BarItem}" InputGestureText="Ctrl+T"/>
                <MenuItem x:Name="MTray" Style="{StaticResource BarItem}"/>
                <Separator/>
                <MenuItem x:Name="MLock" Style="{StaticResource BarItem}"/>
                <Separator/>
                <MenuItem x:Name="MLinkSettings" Style="{StaticResource BarItem}"/>
            </MenuItem>
            <MenuItem Header="_Language">
                <MenuItem x:Name="MKo" Style="{StaticResource BarItem}" Header="한국어"/>
                <MenuItem x:Name="MEn" Style="{StaticResource BarItem}" Header="English"/>
            </MenuItem>
            <MenuItem x:Name="MHelp">
                <MenuItem x:Name="MAbout" Style="{StaticResource BarItem}"/>
            </MenuItem>
        </Menu>

        <!-- 오늘을 보는 중이면 위쪽을 한 번 더 물들인다. 아래로 투명해져 경계선처럼 끊기지 않는다. -->
        <Border x:Name="TodayWash" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#210E7490" Offset="0"/>
                    <GradientStop Color="#000E7490" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- ─── 헤더 ─── -->
        <StackPanel Grid.Row="1" Margin="20,16,20,0">
            <Button x:Name="MonthBtn" Style="{StaticResource MonthBtn}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="YmLabel" VerticalAlignment="Center"/>
                    <ContentControl x:Name="MonthChev" Focusable="False" Margin="4,1,0,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                </StackPanel>
            </Button>

            <DockPanel Margin="0,1,0,0" LastChildFill="True">
                <StackPanel x:Name="Actions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"/>
                <TextBlock x:Name="DayTitle" FontSize="25" FontWeight="Bold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0">
                    <Run x:Name="DayNum"/><Run x:Name="DowRun" FontSize="15" FontWeight="Medium"/>
                </TextBlock>
            </DockPanel>

            <!-- 진행률. 항목이 없어도 자리는 남겨야 아래 영역이 위아래로 밀리지 않는다 -->
            <Grid x:Name="Progress" Height="14" Margin="0,14,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Track" Height="4" CornerRadius="2" Background="{StaticResource Border}" VerticalAlignment="Center" ClipToBounds="True">
                    <Border x:Name="Fill" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource Accent}" Width="0"/>
                </Border>
                <TextBlock x:Name="ProgText" Grid.Column="1" Margin="10,0,0,0" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource Text3}" VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>

        <!-- ─── 달력 ─── -->
        <Border x:Name="Calendar" Grid.Row="2" Margin="20,12,20,4" Padding="12" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" Effect="{StaticResource ShadowMd}"
                Visibility="Collapsed">
            <StackPanel>
                <Grid Margin="2,0,2,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CalPrev" Style="{StaticResource FlatBtn}" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="CalLabel" Grid.Column="1" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CalNext" Style="{StaticResource FlatBtn}"/>
                        <Button x:Name="CalClose" Style="{StaticResource FlatBtn}" Margin="7,0,0,0"/>
                    </StackPanel>
                </Grid>
                <UniformGrid x:Name="CalGrid" Columns="7"/>
            </StackPanel>
        </Border>

        <!-- ─── 검색 ─── -->
        <Border x:Name="SearchBar" Grid.Row="3" Margin="20,0,20,10" Visibility="Collapsed"
                CornerRadius="14" BorderThickness="3" BorderBrush="{StaticResource AccentRing}">
            <Border Height="40" CornerRadius="11" BorderThickness="1" BorderBrush="{StaticResource Accent}"
                    Background="{StaticResource Surface}" Padding="12,0,6,0" Margin="-3">
                <DockPanel>
                    <ContentControl x:Name="SearchIcon" Focusable="False" DockPanel.Dock="Left" Foreground="{StaticResource Accent}"
                                    VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <Button x:Name="SearchClose" DockPanel.Dock="Right" Style="{StaticResource FlatBtn}" Foreground="{StaticResource Text3}"/>
                    <TextBlock x:Name="SearchCount" DockPanel.Dock="Right" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource Text3}" VerticalAlignment="Center" Margin="9,0"/>
                    <TextBox x:Name="SearchInput" Style="{StaticResource BareInput}" FontSize="13.5"/>
                </DockPanel>
            </Border>
        </Border>

        <!-- ─── 고정 항목 ─── -->
        <Border x:Name="Pinned" Grid.Row="4" Margin="20,0,20,10" Padding="9,8,9,9" Background="{StaticResource AccentSoft}"
                BorderBrush="{StaticResource AccentLine}" BorderThickness="1" CornerRadius="12" Visibility="Collapsed">
            <StackPanel>
                <DockPanel Margin="3,0,3,6">
                    <StackPanel x:Name="PinPager" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
                        <Button x:Name="PinPrev" Style="{StaticResource FlatBtn}" Width="20" Height="20" Foreground="{StaticResource Accent}"/>
                        <TextBlock x:Name="PinPage" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Accent}"
                                   MinWidth="26" TextAlignment="Center" VerticalAlignment="Center"/>
                        <Button x:Name="PinNext" Style="{StaticResource FlatBtn}" Width="20" Height="20" Foreground="{StaticResource Accent}"/>
                    </StackPanel>
                    <TextBlock x:Name="PinTitle" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                </DockPanel>
                <StackPanel x:Name="PinList"/>
            </StackPanel>
        </Border>

        <!-- ─── 목록 / 검색 결과 ─── -->
        <Grid Grid.Row="5">
            <ScrollViewer x:Name="ListScroll" Style="{StaticResource ListScroll}">
                <StackPanel x:Name="ListPanel" Margin="20,4,20,16"/>
            </ScrollViewer>
            <ContentControl x:Name="EmptyHost" Focusable="False" IsHitTestVisible="False"/>
        </Grid>

        <!-- ─── 입력 ─── -->
        <Border x:Name="Footer" Grid.Row="6" Padding="20,12,20,16" Background="{StaticResource Bg}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <Border Style="{StaticResource Ring}" CornerRadius="15">
                <Border Style="{StaticResource Field}" Height="44" CornerRadius="12" Padding="15,0,6,0">
                    <DockPanel>
                        <Button x:Name="AddBtn" DockPanel.Dock="Right" Style="{StaticResource SubmitBtn}" IsEnabled="False" Margin="9,0,0,0"/>
                        <TextBox x:Name="Input" Style="{StaticResource BareInput}"/>
                    </DockPanel>
                </Border>
            </Border>
        </Border>

        <!-- 색상 선택 -->
        <Popup x:Name="ColorPop" Placement="Relative" PlacementTarget="{Binding ElementName=Root}" AllowsTransparency="True"
               StaysOpen="False" PopupAnimation="Fade">
            <Border Margin="8,6,8,10" Padding="9" Background="{StaticResource PopBg}" BorderBrush="{StaticResource PopBorder}"
                    BorderThickness="1" CornerRadius="11" Effect="{StaticResource ShadowPop}">
                <UniformGrid x:Name="ColorGrid" Columns="3"/>
            </Border>
        </Popup>
    </Grid>
</Window>

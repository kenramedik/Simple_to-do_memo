<Window x:Class="SimpleToDoMemo.Views.LanguageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Background="{StaticResource Surface}"
        Title="Simple To-Do Memo" Icon="pack://application:,,,/Assets/icon.ico"
        Width="340" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <!-- 최초 실행 - 어느 언어인지 모르니 양쪽 언어로 묻는다 -->
    <StackPanel Margin="22,20,22,20">
        <TextBlock Text="언어를 선택하세요" FontSize="15" FontWeight="Bold"/>
        <TextBlock Text="Choose a language" FontSize="12.5" Foreground="{StaticResource Text2}" Margin="0,3,0,0"/>
        <UniformGrid Columns="2" Margin="0,18,0,0">
            <Button x:Name="KoBtn" Style="{StaticResource PrimaryBtn}" Content="한국어" Height="36" Margin="0,0,4,0" IsDefault="True"/>
            <Button x:Name="EnBtn" Style="{StaticResource GhostBtn}" Content="English" Height="36" Margin="4,0,0,0"
                    BorderBrush="{StaticResource BorderStrong}"/>
        </UniformGrid>
    </StackPanel>
</Window>
